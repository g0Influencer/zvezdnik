PORT=8080
ENV=development

DATABASE_URL=postgres://zvezdnik:password@localhost:5432/zvezdnik
REDIS_URL=redis://localhost:6379

TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=https://t.me/zvezdnik_bot/app
WEBHOOK_BASE_URL=https://api.zvezdnik.app

YANDEX_API_KEY=
YANDEX_FOLDER_ID=b1gbo6kte0r2jcmfsqp4

# Lovable-deployed natal-chart Cloud Function (Swiss Ephemeris via pyswisseph).
# Example: https://functions.yandexcloud.net/<function-id>
ASTRO_NATAL_CHART_URL=

# Robokassa (see .env.prod.example for the full list). Use test creds locally.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_IS_TEST=true
ROBOKASSA_HASH_ALGO=md5
ROBOKASSA_FISCAL=true

PUSH_CRON=0 9 * * *
CHAT_FREE_LIMIT=3
TRIAL_DAYS=7
