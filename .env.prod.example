# Copy to .env.prod on the server (do not commit). Required for app + web.

# --- Web (used by docker-compose for nginx envsubst) ---
PROD_DOMAIN=zvezdnik.app

# --- Postgres (used by both postgres service and DATABASE_URL below) ---
POSTGRES_DB=zvezdnik
POSTGRES_USER=zvezdnik
POSTGRES_PASSWORD=change-me-strong-password

# --- App runtime ---
PORT=8080
ENV=production

# Host references the compose service name; postgres and redis run on the
# default bridge network. Keep credentials in sync with POSTGRES_* above.
DATABASE_URL=postgres://zvezdnik:change-me-strong-password@postgres:5432/zvezdnik?sslmode=disable
REDIS_URL=redis://redis:6379

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=https://zvezdnik.app
WEBHOOK_BASE_URL=https://zvezdnik.app

# --- Yandex Cloud / LLM / Astro ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
ASTRO_NATAL_CHART_URL=https://functions.yandexcloud.net/d4emevcb8j6t0iof9e31

# --- Payments (Robokassa) ---
# From "Мои магазины" -> shop -> "Технические настройки".
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Test-mode passwords + switch (use the test pair while ROBOKASSA_IS_TEST=true).
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_IS_TEST=true
# Hash algorithm — must match the cabinet setting: md5 (default) | sha256 | sha512.
ROBOKASSA_HASH_ALGO=md5
# Attach a fiscal receipt (самозанятый/НПД: tax "none"). Robokassa registers it.
ROBOKASSA_FISCAL=true
# In the Robokassa cabinet set: ResultURL = https://zvezdnikbot.ru/payments/webhook,
# Success URL = https://zvezdnikbot.ru/payment/success, Fail URL = .../payment/fail.

# --- Misc ---
PUSH_CRON=0 9 * * *
TRIAL_DAYS=7

# --- Legal / payment-provider compliance (shown via bot /oferta + pinned msg) ---
# OFFER_URL points at our domain; nginx redirects /oferta to the published doc.
OFFER_URL=https://zvezdnikbot.ru/oferta
SUPPLIER_NAME=
SUPPLIER_INN=
SUPPLIER_CONTACT=
